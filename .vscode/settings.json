{
	"[svelte]": {
		"editor.quickSuggestions": {
			"strings": "on"
		}
	},
	"[typst]": {
		"editor.defaultFormatter": "myriad-dreamin.tinymist"
	},
	"[yaml]": {
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.insertSpaces": true
	},
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.detectIndentation": false,
	"editor.formatOnSave": true,
	"editor.insertSpaces": false,
	"editor.rulers": [100],
	"editor.tabSize": 2,
	"editor.trimAutoWhitespace": true,
	"eslint.validate": ["javascript", "typescript", "svelte"],
	"files.associations": {
		"app.css": "tailwindcss"
	},
	"files.autoGuessEncoding": false,
	"files.encoding": "utf8",
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"js/ts.preferences.importModuleSpecifier": "non-relative",
	"js/ts.preferences.preferTypeOnlyAutoImports": true,
	"js/ts.preferences.quoteStyle": "single",
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"js/ts.tsserver.automaticTypeAcquisition.enabled": true,
	"js/ts.tsserver.checkNpmIsInstalled": false,
	"svelte.enable-ts-plugin": true,
	"svelte.plugin.svelte.defaultScriptLanguage": "ts",
	"tinymist.fontPaths": [
		"${workspaceFolder}/node_modules/source-sans/OTF",
		"${workspaceFolder}/node_modules/source-serif/OTF",
		"${workspaceFolder}/node_modules/source-code-pro/OTF"
	],
	"tinymist.formatterIndentSize": 2,
	"tinymist.formatterMode": "typstyle",
	"tinymist.formatterPrintWidth": 120,
	"tinymist.formatterProseWrap": false,
	"tinymist.systemFonts": false
}
